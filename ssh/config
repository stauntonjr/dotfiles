# Unified SSH client config for Windows and Linux/WSL
# Use ~ paths so this works on both platforms

Host *
  IdentityFile ~/dotfiles/ssh/id_ed25519
  CertificateFile ~/dotfiles/ssh/id_ed25519-cert.pub
  IdentitiesOnly yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  Ciphers aes128-ctr,aes192-ctr,aes256-ctr,aes128-gcm@openssh.com,aes256-gcm@openssh.com,chacha20-poly1305@openssh.com

Host github.com
  User git
  IdentityFile ~/dotfiles/ssh/id_ed25519
  IdentitiesOnly yes

